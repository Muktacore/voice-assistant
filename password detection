import pyttsx3
import time
import win32evtlog  # Windows Event Logs
import win32evtlogutil
import win32security

# Initialize text-to-speech engine
engine = pyttsx3.init()
engine.setProperty('rate', 150)  # Adjust speech speed
engine.setProperty('volume', 1)  # Adjust volume (0 to 1)

def speak(text):
    """Make the assistant speak."""
    engine.say(text)
    engine.runAndWait()

def get_failed_logins():
    """Check Windows Security Logs for failed login attempts."""
    server = None  # Local machine
    log_type = "Security"
    hand = win32evtlog.OpenEventLog(server, log_type)

    flags = win32evtlog.EVENTLOG_BACKWARDS_READ | win32evtlog.EVENTLOG_SEQUENTIAL_READ
    total_records = win32evtlog.GetNumberOfEventLogRecords(hand)

    while True:
        events = win32evtlog.ReadEventLog(hand, flags, 0)

        for event in events:
            if event.EventID == 4625:  # 4625 = Failed login attempt
                speak("I don't know you!")  # Voice response
                print("Alert: Wrong password attempt detected!")  # Debugging
                time.sleep(5)  # Prevent multiple alerts in a short time

        time.sleep(3)  # Check every 3 seconds

# Run the function
if __name__ == "__main__":
    print("Monitoring failed login attempts... (Run as Admin)")
    speak("Monitoring login attempts.")
    get_failed_logins()
